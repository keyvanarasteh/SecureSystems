# Git satır sonu dönüşümleri — tüm platformlarda tutarlılık
* text=auto

# Metin dosyaları — LF zorla
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.env text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
Makefile text eol=lf

# İkili dosyalar — dönüşüm yapma
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.lock binary

# Git diff görünümü iyileştirme
*.md diff=markdown
*.css diff=css
*.html diff=html
